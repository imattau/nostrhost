{
	admin 127.0.0.1:2019
	http_port 80
	https_port 443
	storage file_system {
		root /var/lib/caddy
	}
	acme_ca https://127.0.0.1:14000/dir
}

# P2: default domain -- minimal site so Caddy obtains a cert and certd exports
# it to /etc/yunohost/certs/yunohost.org for slapd (LDAP).
yunohost.org {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "no-referrer"
		Permissions-Policy "interest-cohort=()"
		Content-Security-Policy "upgrade-insecure-requests"
	}
	handle {
		respond "default domain (caddy P2)" 200
	}
}

# P2 spike: nostrhost.test via the Pebble test CA (127.0.0.1:14000).
# HTTP-01 is served on Caddy's HTTP listener (:8080); Pebble's VA is
# configured with httpPort 8080 and resolves the names to 127.0.0.1 via
# /etc/hosts, so validation stays on loopback and never touches nginx.
nostrhost.test {
	# Ported from conf/nginx/security.conf.inc (base, non-experimental set) +
	# the SSO portal CSP (yunohost_sso.conf.inc) which the portal SPA needs.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "no-referrer"
		Permissions-Policy "interest-cohort=()"
		Content-Security-Policy "upgrade-insecure-requests; default-src 'self'; connect-src 'self' ws: wss:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; img-src 'self' data:;"
	}

	redir /yunohost/sso /yunohost/sso/ permanent
	redir /yunohost/admin /yunohost/admin/ permanent

	handle_path /yunohost/sso/applogos/* {
		root * /usr/share/yunohost/applogos
		file_server
	}

	handle_path /yunohost/sso/* {
		root * /usr/share/yunohost/portal
		try_files {path} /index.html
		file_server
	}

	handle_path /yunohost/admin/* {
		root * /usr/share/yunohost/admin
		try_files {path} /index.html
		file_server
	}

	handle_path /yunohost/api/* {
		reverse_proxy 127.0.0.1:6787
	}

	handle_path /yunohost/portalapi/* {
		reverse_proxy 127.0.0.1:6788
	}

	handle /.well-known/openid-configuration {
		reverse_proxy 127.0.0.1:6788
	}

	handle /oidc/* {
		reverse_proxy 127.0.0.1:6788
	}

	handle /nostrhost-test-catalog/* {
		# forward_auth runs first (sees the original URI for permission
		# matching); the nested handle strips the prefix for file_server,
		# sidestepping Caddy's directive ordering (uri < forward_auth).
		forward_auth 127.0.0.1:6788 {
			uri /nostr/auth-request
			copy_headers X-Remote-User X-Remote-Email X-Remote-Fullname X-Nostr-Pubkey X-Nostr-Npub
		}
		handle {
			uri strip_prefix /nostrhost-test-catalog
			root * /var/www/nostrhost-test__2
			file_server
		}
	}

	handle /nostrhost-test/* {
		forward_auth 127.0.0.1:6788 {
			uri /nostr/auth-request
			copy_headers X-Remote-User X-Remote-Email X-Remote-Fullname X-Nostr-Pubkey X-Nostr-Npub
		}
		handle {
			uri strip_prefix /nostrhost-test
			root * /var/www/nostrhost-test
			file_server
		}
	}

	handle {
		respond "nostrhost caddy P2 ACME spike" 200
	}
}