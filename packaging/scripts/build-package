#!/usr/bin/env python3
"""build-package — build one nostrhost .deb from its pinned submodule source.

Reads the APT release BOM (packaging/packages.yml), resolves the pinned
submodule for the package's source, and produces a .deb for the package kinds
that need wrapping (golang, python, spa, config, caddy). Meta-packages are
generated by generate-meta-package; the `debian-source` kind (nostrhost-core)
is built with dpkg-buildpackage inside its own debian/ tree by the workflow.

Usage:
    build-package --name nostrhost-control [-o outdir] [--version X.Y.Z]
    build-package --name nostrhost-admin   [-o outdir] [--version X.Y.Z]

The source submodule must be present (checked out as part of the umbrella).
Versions come from the manifest, overridable per-package via --version (the
release workflow passes the matching control/v*, notify/v*, etc. tag).
"""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

try:
    import yaml
except ImportError:  # pragma: no cover
    sys.exit("build-package: PyYAML is required (python3-yaml)")

UMBRELLA = Path(__file__).resolve().parents[2]  # repo root


def run(cmd: list[str], cwd: Path, **kw) -> str:
    p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, **kw)
    if p.returncode != 0:
        raise SystemExit(
            f"{' '.join(cmd)} failed (rc={p.returncode})\n--- stdout ---\n{p.stdout}"
            f"\n--- stderr ---\n{p.stderr}"
        )
    return p.stdout


def deb_build(staging: Path, out: Path) -> None:
    # Temporary staging roots inherit tempfile's private 0700 mode, while the
    # caller's umask may otherwise leave group-writable package files. Debian
    # packages need searchable roots and must never ship writable executables
    # or units for unprivileged groups.
    staging.chmod(0o755)
    for current, dirs, files in os.walk(staging):
        current_path = Path(current)
        if current_path != staging:
            current_path.chmod(current_path.stat().st_mode & 0o755)
        for dirname in dirs:
            path = current_path / dirname
            path.chmod(path.stat().st_mode & 0o755)
        for filename in files:
            path = current_path / filename
            path.chmod(path.stat().st_mode & 0o755)
    subprocess.run(
        ["dpkg-deb", "--build", "--root-owner-group", str(staging), str(out)],
        check=True,
        capture_output=True,
        text=True,
    )


def write_control(staging: Path, name: str, version: str, arch: str, summary: str,
                  depends: list[str], provides: list[str],
                  conflicts: list[str], replaces: list[str]) -> None:
    ctrl = (
        f"Package: {name}\n"
        f"Version: {version}\n"
        f"Section: utils\n"
        f"Priority: optional\n"
        f"Architecture: {arch}\n"
        f"Maintainer: NostrHost <noreply@nostrhost.org>\n"
        f"Description: {summary}\n"
    )
    if depends:
        ctrl += "Depends: " + ",\n ".join(depends) + "\n"
    if provides:
        ctrl += "Provides: " + ", ".join(provides) + "\n"
    if conflicts:
        ctrl += "Conflicts: " + ", ".join(conflicts) + "\n"
    if replaces:
        ctrl += "Replaces: " + ", ".join(replaces) + "\n"
    (staging / "DEBIAN").mkdir(parents=True, exist_ok=True)
    (staging / "DEBIAN" / "control").write_text(ctrl, encoding="utf-8")


def build_golang(pkg: dict, version: str, outdir: Path) -> Path:
    name = pkg["name"]
    src = pkg["source"]
    sub = UMBRELLA / src["submodule"]
    cmd_dir = sub / src["cmd"]
    arch = "amd64"
    staging = Path(tempfile.mkdtemp(prefix="nostrhost-godeb-"))
    try:
        bindir = staging / "usr" / "bin"
        bindir.mkdir(parents=True)
        binname = name  # nostrhost-control -> /usr/bin/nostrhost-control
        run(["go", "build", "-o", str(bindir / binname), "."], cmd_dir,
            env={**os.environ, "CGO_ENABLED": "0"})
        if src.get("systemd"):
            unit = sub / "deploy" / src["systemd"]
            if not unit.is_file():
                raise SystemExit(f"build-package: declared systemd unit not found: {unit}")
            (staging / "lib" / "systemd" / "system").mkdir(parents=True, exist_ok=True)
            shutil.copy2(unit, staging / "lib" / "systemd" / "system" / src["systemd"])
        write_control(staging, name, version, arch, pkg.get("summary", ""),
                      pkg.get("depends", []), pkg.get("provides", []),
                      pkg.get("conflicts", []), pkg.get("replaces", []))
        allowed_scripts = {"preinst", "postinst", "prerm", "postrm"}
        for script_name, relative_path in src.get("maintainer_scripts", {}).items():
            if script_name not in allowed_scripts:
                raise SystemExit(f"build-package: unsupported maintainer script {script_name!r}")
            script = sub / relative_path
            if not script.is_file():
                raise SystemExit(f"build-package: declared maintainer script not found: {script}")
            target = staging / "DEBIAN" / script_name
            shutil.copy2(script, target)
            target.chmod(0o755)
        out = outdir / f"{name}_{version}_{arch}.deb"
        deb_build(staging, out)
        return out
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def build_python(pkg: dict, version: str, outdir: Path) -> Path:
    name = pkg["name"]
    src = pkg["source"]
    sub = UMBRELLA / src["submodule"]
    arch = "all"
    staging = Path(tempfile.mkdtemp(prefix="nostrhost-pydeb-"))
    try:
        # build a wheel, then install its contents into the standard Debian
        # path /usr/lib/python3/dist-packages inside the staging root.
        wheeldir = staging / "wheels"
        wheeldir.mkdir()
        run(["python3", "-m", "build", "--wheel", "--outdir", str(wheeldir)], sub)
        wheel = next(wheeldir.glob("*.whl"))

        target = Path(tempfile.mkdtemp(prefix="nostrhost-pyinstall-"))
        run(["python3", "-m", "pip", "install", "--no-deps", "--no-compile",
             "--target", str(target), str(wheel)], sub)

        dist_packages = staging / "usr" / "lib" / "python3" / "dist-packages"
        dist_packages.mkdir(parents=True, exist_ok=True)
        for item in target.iterdir():
            shutil.move(str(item), dist_packages / item.name)
        shutil.rmtree(target, ignore_errors=True)
        shutil.rmtree(wheeldir)

        write_control(staging, name, version, arch, pkg.get("summary", ""),
                      pkg.get("depends", []), pkg.get("provides", []),
                      pkg.get("conflicts", []), pkg.get("replaces", []))
        out = outdir / f"{name}_{version}_{arch}.deb"
        deb_build(staging, out)
        return out
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def build_spa(pkg: dict, version: str, outdir: Path) -> Path:
    name = pkg["name"]
    src = pkg["source"]
    sub = UMBRELLA / src["submodule"]
    arch = "all"
    build_dir = sub / src.get("build_dir", "")
    staging = Path(tempfile.mkdtemp(prefix="nostrhost-spadeb-"))
    try:
        package_manager = src.get("package_manager")
        output_dir = src.get("output_dir")
        if not package_manager or not output_dir:
            raise SystemExit(f"build-package: SPA {name} must declare package_manager and output_dir")
        if not build_dir.is_dir():
            raise SystemExit(f"build-package: SPA build directory does not exist: {build_dir}")
        manager = shutil.which("corepack")
        if manager is None:
            raise SystemExit("build-package: corepack is required to build SPA packages; install Node.js 22")
        static_src = (build_dir / output_dir).resolve()
        if build_dir.resolve() not in static_src.parents:
            raise SystemExit(f"build-package: SPA output_dir must remain under {build_dir}")
        # Clear generated output first so an unsuccessful build can never fall
        # through to packaging an old dist/ directory.
        shutil.rmtree(static_src, ignore_errors=True)
        run([manager, package_manager, *src.get("install_args", ["install", "--frozen-lockfile"])], build_dir)
        build_env = dict(os.environ)
        if src.get("base_path"):
            build_env["VITE_BASE_URL"] = src["base_path"]
        run([manager, package_manager, *src.get("build_args", ["build"])], build_dir, env=build_env)
        if not static_src.is_dir() or not any(static_src.iterdir()):
            raise SystemExit(f"build-package: SPA build did not produce non-empty output at {static_src}")
        dest = staging / src["static_dir"].lstrip("/")
        shutil.copytree(static_src, dest)
        write_control(staging, name, version, arch, pkg.get("summary", ""),
                      pkg.get("depends", []), pkg.get("provides", []),
                      pkg.get("conflicts", []), pkg.get("replaces", []))
        out = outdir / f"{name}_{version}_{arch}.deb"
        deb_build(staging, out)
        return out
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def build_config(pkg: dict, version: str, outdir: Path) -> Path:
    name = pkg["name"]
    arch = "all"
    staging = Path(tempfile.mkdtemp(prefix="nostrhost-confdeb-"))
    try:
        sub = pkg.get("source", {}).get("submodule")
        base = (UMBRELLA / sub) if sub else UMBRELLA
        for item in pkg.get("files", []):
            s = base / item["source"]
            d = staging / item["dest"].lstrip("/")
            if s.is_dir():
                shutil.copytree(s, d)
            elif s.is_file():
                d.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(s, d)
            else:
                raise SystemExit(f"build-package: config source not found: {s}")
        write_control(staging, name, version, arch, pkg.get("summary", ""),
                      pkg.get("depends", []), pkg.get("provides", []),
                      pkg.get("conflicts", []), pkg.get("replaces", []))
        out = outdir / f"{name}_{version}_{arch}.deb"
        deb_build(staging, out)
        return out
    finally:
        shutil.rmtree(staging, ignore_errors=True)


# Private runtime venv: created with --system-site-packages so the dist-packages
# debs (nostrhost, nostrhost_auth, nostrhost_policy, yunohost, typer, bottle,
# ...) stay visible; the bundled wheels layer the pip-only deps on top. Daemons
# and units run on /opt/nostrhost/venv/bin/python (see docs/ALPHA-PLAN.md §W1).
RUNTIME_POSTINST = """#!/bin/sh
set -e

VENV=/opt/nostrhost/venv
WHEELS=/usr/share/nostrhost/wheels
REQS=/usr/share/nostrhost/runtime-requirements.txt

case "$1" in
  configure)
    if [ ! -x "$VENV/bin/python" ]; then
      rm -rf "$VENV"
      python3 -m venv --system-site-packages "$VENV"
    fi
    "$VENV/bin/pip" install --no-index \\
      --ignore-installed \\
      --find-links="$WHEELS" \\
      --disable-pip-version-check \\
      -r "$REQS"
    ;;
  abort-upgrade|abort-remove|abort-deconfigure|'')
    ;;
esac
exit 0
"""

RUNTIME_POSTRM = """#!/bin/sh
set -e

VENV=/opt/nostrhost/venv

case "$1" in
  purge)
    rm -rf "$VENV"
    ;;
esac
exit 0
"""


def build_runtime(pkg: dict, version: str, outdir: Path) -> Path:
    """Bundle pinned manylinux cp311 wheels; postinst builds /opt/nostrhost/venv.

    Wheels are downloaded at build time (reproducible, offline install), not
    checked into the umbrella. The `runtime` kind has no submodule: its source
    is the pinned requirements file declared under source.requirements.
    """
    name = pkg["name"]
    arch = "amd64"          # wheels are built for x86_64; repo arch is amd64
    staging = Path(tempfile.mkdtemp(prefix="nostrhost-runtime-"))
    try:
        reqfile = UMBRELLA / pkg["source"]["requirements"]
        if not reqfile.exists():
            raise SystemExit(f"build-package: runtime requirements not found: {reqfile}")
        share = staging / "usr" / "share" / "nostrhost"
        wheels_dir = share / "wheels"
        wheels_dir.mkdir(parents=True)
        run(
            ["python3", "-m", "pip", "download",
             "--only-binary=:all:",
             "--dest", str(wheels_dir),
             "--platform", "manylinux_2_17_x86_64",
             "--python-version", "3.11",
             "--implementation", "cp",
             "--abi", "cp311",
             "-r", str(reqfile)],
            UMBRELLA,
        )
        shutil.copy2(reqfile, share / "runtime-requirements.txt")
        write_control(staging, name, version, arch, pkg.get("summary", ""),
                      pkg.get("depends", []), [], [], [])
        (staging / "DEBIAN" / "postinst").write_text(RUNTIME_POSTINST, encoding="utf-8")
        (staging / "DEBIAN" / "postinst").chmod(0o755)
        (staging / "DEBIAN" / "postrm").write_text(RUNTIME_POSTRM, encoding="utf-8")
        (staging / "DEBIAN" / "postrm").chmod(0o755)
        out = outdir / f"{name}_{version}_{arch}.deb"
        deb_build(staging, out)
        return out
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def build_caddy(pkg: dict, version: str, outdir: Path) -> Path:
    """xcaddy build of stock Caddy + nostrhost modules."""
    name = pkg["name"]
    arch = "amd64"
    staging = Path(tempfile.mkdtemp(prefix="nostrhost-caddydeb-"))
    try:
        xcaddy = shutil.which("xcaddy")
        if xcaddy is None:
            raise SystemExit("build-package: xcaddy not found (go install "
                             "github.com/caddyserver/xcaddy/cmd/xcaddy@latest)")
        bindir = staging / "usr" / "bin"
        bindir.mkdir(parents=True)
        cmd = [xcaddy, "build", "--output", str(bindir / "caddy")]
        for m in pkg["source"].get("xcaddy_modules", []):
            cmd += ["--with", m]
        run(cmd, UMBRELLA)
        write_control(staging, name, version, arch, pkg.get("summary", ""),
                      pkg.get("depends", []), pkg.get("provides", []),
                      pkg.get("conflicts", []), pkg.get("replaces", []))
        out = outdir / f"{name}_{version}_{arch}.deb"
        deb_build(staging, out)
        return out
    finally:
        shutil.rmtree(staging, ignore_errors=True)


BUILDERS = {
    "golang": build_golang,
    "python": build_python,
    "spa": build_spa,
    "config": build_config,
    "caddy": build_caddy,
    "runtime": build_runtime,
}


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--name", required=True)
    ap.add_argument("--packages", default="packaging/packages.yml")
    ap.add_argument("-o", "--outdir", default="packaging/build")
    ap.add_argument("--version")
    args = ap.parse_args()

    with open(UMBRELLA / args.packages, encoding="utf-8") as fh:
        manifest = yaml.safe_load(fh)

    pkg = next((p for p in manifest["packages"] if p["name"] == args.name), None)
    if pkg is None:
        raise SystemExit(f"build-package: unknown package {args.name!r} in {args.packages}")
    kind = pkg.get("kind")
    if kind == "meta":
        raise SystemExit("build-package: meta packages are generated by generate-meta-package")
    if kind == "debian-source":
        raise SystemExit("build-package: nostrhost-core is built via dpkg-buildpackage "
                         "in the workflow (debian-source kind)")

    builder = BUILDERS.get(kind)
    if builder is None:
        raise SystemExit(f"build-package: no builder for kind {kind!r}")

    version = args.version or str(pkg.get("version", "0.1.0"))
    outdir = Path(args.outdir)
    outdir.mkdir(parents=True, exist_ok=True)
    out = builder(pkg, version, outdir)
    print(f"built {out.name}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
