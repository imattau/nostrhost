{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/imattau/nostrhost/blob/main/authority/event-protocol/schemas/31100-capability.schema.json",
  "title": "kind 31100 — capability grant",
  "description": "Addressable. d tag = subject pubkey (64-hex). Empty scopes means revoke. content.revision is optional (legacy documents are revision 0).",
  "type": "object",
  "required": ["type"],
  "additionalProperties": false,
  "properties": {
    "type": { "type": "string", "minLength": 1 },
    "scopes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "schema": { "type": "integer", "minimum": 1 },
    "server": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "subject": { "type": "string" },
    "enabled": { "type": "boolean" },
    "revision": { "type": "integer", "minimum": 0 },
    "updated_by": { "type": "string" },
    "reason": { "type": "string" }
  }
}
