{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/imattau/nostrhost/blob/main/authority/event-protocol/schemas/31101-policy.schema.json",
  "title": "kind 31101 — trust/policy declaration",
  "description": "Addressable, schema-versioned small non-secret policy document. `schema` is required for this kind (unlike legacy kinds). Policy data lives under `value` so the envelope stays uniform.",
  "type": "object",
  "required": ["schema"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "integer", "minimum": 1 },
    "value": { "type": "object" },
    "server": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "subject": { "type": "string" },
    "enabled": { "type": "boolean" },
    "revision": { "type": "integer", "minimum": 0 },
    "updated_by": { "type": "string" },
    "reason": { "type": "string" }
  }
}
