{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/imattau/nostrhost/blob/main/schema/authority-registry.schema.json",
  "title": "NostrHost authority registry",
  "description": "Contract for authority/registry.toml (WP0 of docs/RELAY-STATE-MIGRATION-PLAN.md). One entry per persistent control-plane fact; exactly one authority per fact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "state"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Registry schema version."
    },
    "state": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/state" }
    }
  },
  "definitions": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "class",
        "owner",
        "sensitivity",
        "target_authority",
        "retention",
        "recovery"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Stable slug, unique across the registry."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute host path, absolute glob (ending /**), repo-relative path, or logical coordinate such as in-memory:Name or relay:kind."
        },
        "class": {
          "type": "string",
          "enum": [
            "event",
            "repository",
            "secret",
            "bootstrap",
            "projection",
            "transactional",
            "external"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "Component or source artifact that owns the fact."
        },
        "readers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "writers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "sensitivity": {
          "type": "string",
          "enum": ["secret", "private", "public"]
        },
        "target_authority": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical source: events:<kind>, ngit:<repo>, secret-store, local:<role>, external:<owner>, projection:cache, projection:cursor."
        },
        "retention": { "type": "string", "minLength": 1 },
        "recovery": { "type": "string", "minLength": 1 },
        "direct_writes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": [],
          "description": "Repo-relative code paths that mutate this store without first publishing a signed event (only meaningful for event/repository authority)."
        },
        "notes": { "type": "string" }
      }
    }
  }
}
