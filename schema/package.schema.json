{
  "$id": "https://github.com/imattau/nostrhost/blob/main/schema/package.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "AccessResource": {
      "properties": {
        "group": {
