          "maximum": 10000,
          "title": "Max Children",
          "type": "integer"
        },
        "socket": {
          "format": "path",
          "title": "Socket",
          "type": "string"
        },
        "user": {
          "title": "User",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "socket",
        "user",
        "group"
      ],
      "title": "PhpFpmResource",
      "type": "object"
    },
    "PolicyResource": {
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "logrotate",
            "crowdsec"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
