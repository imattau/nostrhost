        },
        "auth_header": {
          "default": true,
          "title": "Auth Header",
          "type": "boolean"
        },
        "auth_request": {
          "default": false,
          "title": "Auth Request",
          "type": "boolean"
        },
        "protected": {
          "default": false,
          "title": "Protected",
          "type": "boolean"
        },
        "show_tile": {
          "title": "Show Tile",
          "type": "boolean"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "title": "PermissionResource",
      "type": "object"
    },
    "PhpFpmResource": {
      "properties": {
        "group": {
          "title": "Group",
          "type": "string"
        },
        "max_children": {
          "default": 10,
