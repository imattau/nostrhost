          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "DirectoryResource",
      "type": "object"
    },
    "DnsRecordResource": {
      "description": "One app-declared DNS record (``[dns.<name>]``, W4 Phase B).\n\n``name`` is relative to the app's ``web.domain`` (``@`` for the apex).\nNostrHost enforces the record through the domain's provider and owns it\n(``app:<id>``), deleting it when the app goes away. The record is\nreconciled inside the domain's own zone, so ``web.domain`` must be a\nregistered native domain.",
      "properties": {
        "name": {
          "default": "@",
          "title": "Name",
          "type": "string"
        },
        "ttl": {
          "default": 3600,
          "title": "Ttl",
          "type": "integer"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "DnsRecordResource",
      "type": "object"
    },
    "HealthResource": {
      "properties": {
        "path": {
          "default": "/health",
          "title": "Path",
          "type": "string"
        },
        "retries": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "timeout": {
          "default": 10,
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Timeout",
          "type": "integer"
        },
        "type": {
          "default": "http",
          "enum": [
            "http"
