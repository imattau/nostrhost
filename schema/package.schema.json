          "default": false,
          "title": "Backup",
          "type": "boolean"
        },
        "group": {
          "title": "Group",
          "type": "string"
        },
        "mode": {
          "default": 488,
          "maximum": 4095,
          "minimum": 0,
          "title": "Mode",
