        },
        "default": {
          "title": "Default"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "group": {
          "title": "Group",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "secret": {
          "default": false,
          "title": "Secret",
          "type": "boolean"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "enum"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "SettingField",
      "type": "object"
    },
    "SettingResource": {
      "properties": {
        "fields": {
          "additionalProperties": {
            "$ref": "#/definitions/SettingField"
          },
          "title": "Fields",
          "type": "object"
        },
        "values": {
          "title": "Values",
          "type": "object"
        }
      },
      "title": "SettingResource",
      "type": "object"
    },
    "SourceResource": {
      "properties": {
        "destination": {
          "format": "path",
          "title": "Destination",
          "type": "string"
        },
        "extract": {
          "default": true,
          "title": "Extract",
          "type": "boolean"
        },
        "format": {
          "default": "auto",
          "enum": [
            "auto",
            "tar",
            "zip",
            "file"
          ],
          "title": "Format",
          "type": "string"
        },
        "id": {
          "default": "main",
          "title": "Id",
          "type": "string"
        },
        "platform": {
          "title": "Platform",
          "type": "string"
        },
        "rename": {
          "title": "Rename",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Sha256",
          "type": "string"
        },
        "strip_components": {
          "default": 0,
          "maximum": 16,
          "minimum": 0,
          "title": "Strip Components",
          "type": "integer"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "variants": {
          "additionalProperties": {
            "$ref": "#/definitions/SourceVariant"
          },
          "title": "Variants",
          "type": "object"
        }
      },
      "title": "SourceResource",
      "type": "object"
    },
    "SourceVariant": {
      "properties": {
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Sha256",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "sha256"
      ],
      "title": "SourceVariant",
      "type": "object"
    },
    "TimerResource": {
      "properties": {
        "exec": {
          "minLength": 1,
          "title": "Exec",
          "type": "string"
        },
        "on_calendar": {
          "minLength": 1,
          "title": "On Calendar",
          "type": "string"
        },
        "persistent": {
          "default": true,
          "title": "Persistent",
          "type": "boolean"
        }
      },
      "required": [
        "on_calendar",
        "exec"
      ],
      "title": "TimerResource",
      "type": "object"
    },
    "UserResource": {
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "groups": {
          "items": {
            "type": "string"
          },
          "title": "Groups",
          "type": "array"
        },
        "home": {
          "format": "path",
          "title": "Home",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "system": {
          "default": true,
          "title": "System",
          "type": "boolean"
        }
      },
      "title": "UserResource",
      "type": "object"
    },
    "WebResource": {
      "properties": {
        "auth": {
          "default": "none",
          "enum": [
            "none",
            "nostrhost"
          ],
          "title": "Auth",
          "type": "string"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "file_root": {
          "title": "File Root",
          "type": "string"
        },
        "https": {
          "default": "automatic",
          "enum": [
            "automatic",
            "required",
            "disabled"
          ],
          "title": "Https",
          "type": "string"
        },
        "path": {
          "default": "/",
          "title": "Path",
          "type": "string"
        },
        "upstream": {
          "minLength": 1,
          "title": "Upstream",
          "type": "string"
        }
      },
      "title": "WebResource",
      "type": "object"
    }
  },
  "description": "Declarative NostrHost package manifest. Validation is read-only; privileged changes require a separately approved plan.",
  "properties": {
    "access": {
      "additionalProperties": {
        "$ref": "#/definitions/AccessResource"
      },
      "description": "Filesystem ownership and mode changes on existing paths; declare an owner or group explicitly.",
      "title": "Access",
      "type": "object"
    },
    "app": {
      "$ref": "#/definitions/AppResource",
      "description": "Required package identity and version. Keep the id stable across releases."
    },
    "backup": {
      "$ref": "#/definitions/BackupResource",
      "description": "Filesystem paths and database inputs registered with the backup plane."
    },
    "config": {
      "additionalProperties": {
        "$ref": "#/definitions/ConfigFileResource"
      },
      "description": "Managed configuration files with exactly one content or template source.",
      "title": "Config",
      "type": "object"
    },
    "database": {
      "$ref": "#/definitions/DatabaseResource",
      "description": "A package-owned database and its users/grants. State explicitly whether database data is backed up."
    },
    "directories": {
      "additionalProperties": {
        "$ref": "#/definitions/DirectoryResource"
      },
      "description": "Absolute package-owned paths, access modes, and backup intent.",
      "title": "Directories",
      "type": "object"
    },
    "dns": {
      "additionalProperties": {
        "$ref": "#/definitions/DnsRecordResource"
      },
      "description": "Records owned by this app inside the zone for the declared web domain.",
      "title": "Dns",
      "type": "object"
    },
    "fpm": {
      "$ref": "#/definitions/PhpFpmResource",
      "description": "PHP-FPM pool configuration. Declare a matching PHP runtime as well."
    },
    "health": {
      "$ref": "#/definitions/HealthResource",
      "description": "A bounded HTTP health check used to verify the resulting service or web route."
    },
    "hooks": {
      "additionalProperties": {
        "$ref": "#/definitions/HookResource"
      },
      "description": "Restricted Python hook references for behavior not expressible as a resource; hooks are not shell snippets.",
      "title": "Hooks",
      "type": "object"
    },
    "packages": {
      "$ref": "#/definitions/PackagesResource",
      "description": "APT dependencies owned by the host package manager; shared packages are retained on app removal."
    },
    "permissions": {
      "additionalProperties": {
        "$ref": "#/definitions/PermissionResource"
      },
      "description": "Portal access policy for the package's web routes; this is distinct from filesystem access.",
      "title": "Permissions",
      "type": "object"
    },
    "policies": {
      "additionalProperties": {
        "$ref": "#/definitions/PolicyResource"
      },
      "description": "Typed host security/log rotation policies rendered through registered providers.",
      "title": "Policies",
      "type": "object"
    },
    "ports": {
      "$ref": "#/definitions/PortsResource",
      "description": "Named, unique TCP/UDP port allocations requested by the package."
    },
    "runtime": {
      "$ref": "#/definitions/RuntimeResource",
      "description": "A host-managed language runtime and version; use an explicit prefix only for an isolated runtime."
    },
    "secrets": {
      "additionalProperties": {
        "$ref": "#/definitions/SecretResource"
      },
      "description": "Generated secret resources; never embed secret values in the manifest.",
      "title": "Secrets",
      "type": "object"
    },
    "service": {
      "$ref": "#/definitions/ServiceResource",
      "description": "A systemd service with an absolute executable path and an optional declared system user."
    },
    "settings": {
      "$ref": "#/definitions/SettingResource",
      "description": "Typed non-secret package settings and defaults. Store credentials with secrets instead."
    },
    "source": {
      "additionalProperties": {
        "$ref": "#/definitions/SourceResource"
      },
      "description": "Verified upstream archives. Every source requires a SHA-256 digest, including each platform variant.",
      "title": "Source",
      "type": "object"
    },
    "timer": {
      "$ref": "#/definitions/TimerResource",
      "description": "A systemd timer and absolute executable for recurring package work."
    },
    "user": {
      "$ref": "#/definitions/UserResource",
      "description": "Optional system account owned by this package. Services should use this declared identity."
    },
    "web": {
      "$ref": "#/definitions/WebResource",
      "description": "A Caddy route to an upstream or static file root. Use a registered domain and package route."
    }
  },
  "required": [
    "app"
  ],
  "title": "PackageManifest",
  "type": "object"
}
