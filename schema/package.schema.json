    "ServiceResource": {
      "properties": {
        "credentials": {
          "additionalProperties": {
            "format": "path",
            "type": "string"
          },
          "title": "Credentials",
          "type": "object"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "exec": {
          "minLength": 1,
          "title": "Exec",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "restart": {
          "default": "on-failure",
          "enum": [
            "no",
            "on-failure",
            "always"
          ],
          "title": "Restart",
          "type": "string"
        },
        "security": {
          "$ref": "#/definitions/ServiceSecurity"
        },
        "user": {
          "title": "User",
          "type": "string"
        },
        "working_directory": {
          "format": "path",
          "title": "Working Directory",
          "type": "string"
        }
      },
      "required": [
        "exec"
      ],
      "title": "ServiceResource",
      "type": "object"
    },
    "ServiceSecurity": {
