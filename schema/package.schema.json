        },
        "read_write_paths": {
          "items": {
            "type": "string"
          },
          "title": "Read Write Paths",
          "type": "array"
        }
      },
      "title": "ServiceSecurity",
      "type": "object"
    },
    "SettingField": {
      "properties": {
        "choices": {
          "items": {
            "type": "string"
          },
          "title": "Choices",
