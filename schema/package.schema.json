        },
        "private_tmp": {
          "default": true,
          "title": "Private Tmp",
          "type": "boolean"
        },
        "protect_home": {
          "default": true,
          "title": "Protect Home",
          "type": "boolean"
        },
        "protect_system": {
          "default": "strict",
          "enum": [
            "strict",
            "full",
            "yes",
            "no"
          ],
          "title": "Protect System",
